{
  "manifest_version": 3,
  "name": "Gradstreet Copy Helper",
  "version": "2.4.0",
  "description": "Extract Gradstreet assessment questions with drag-and-drop and paste code directly into the Monaco editor.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://gradstreet.instacks.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GSAK",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gradstreet.instacks.co/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://gradstreet.instacks.co/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.js"
      ],
      "matches": [
        "https://gradstreet.instacks.co/*"
      ]
    }
  ]
}